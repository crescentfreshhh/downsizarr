# ---------------------------------------------------------------------------
# Downsizarr configuration. Copy to .env and adjust, or set these directly in
# your Unraid Docker template / docker-compose environment block.
# ---------------------------------------------------------------------------

# Root directory that Downsizarr is allowed to browse and write into. This is
# the in-container path your Unraid share is mounted to (see docker-compose).
# Downsizarr will NEVER read or write outside this root.
DOWNSIZARR_MEDIA_ROOT=/media

# Where the SQLite metrics DB and logs live (mount this to persist history).
DOWNSIZARR_DATA_DIR=/config

# Suffix inserted before the extension on converted files.
#   Movie.mkv  ->  Movie.hevc.mkv
DOWNSIZARR_OUTPUT_SUFFIX=.hevc

# Optional: force a container/extension for output (e.g. mkv). Leave blank to
# keep the source container.
DOWNSIZARR_OUTPUT_CONTAINER=

# How many transcodes may run at once. Keep at 1 for QA / libx265 slow.
DOWNSIZARR_MAX_CONCURRENT=1

# Default encode settings (all overridable per-batch in the GUI).
#   Encoders: libx265 (CPU), hevc_nvenc (NVIDIA GPU/CUDA), hevc_qsv (Intel),
#             hevc_vaapi (Intel/AMD).
DOWNSIZARR_DEFAULT_ENCODER=libx265
DOWNSIZARR_DEFAULT_CRF=18
DOWNSIZARR_DEFAULT_PRESET=slow

# For the NVIDIA encoder: default the full CUDA pipeline (GPU decode + encode)
# on. Off = GPU encodes but CPU decodes (more compatible). Overridable per batch.
DOWNSIZARR_DEFAULT_GPU_DECODE=false

# Measure output quality with VMAF by default (0..100 vs source). Adds a
# second analysis pass per file, so it's slower. Overridable per batch.
DOWNSIZARR_DEFAULT_VMAF=false
# Threads for VMAF scoring (0 = let ffmpeg decide).
DOWNSIZARR_VMAF_THREADS=0

# Skip files that are already HEVC/H265 instead of re-encoding them.
DOWNSIZARR_SKIP_ALREADY_HEVC=true

# Annotate output filenames with the encode method / quality used. Useful while
# A/B testing encoders. Overridable per batch in the GUI.
#   tag_encoder -> Movie.hevc.nvenc.mkv
#   tag_quality -> Movie.hevc.crf18-slow.mkv
DOWNSIZARR_TAG_ENCODER=false
DOWNSIZARR_TAG_QUALITY=false

# Paths to ffmpeg/ffprobe (override only if not on PATH).
DOWNSIZARR_FFMPEG=ffmpeg
DOWNSIZARR_FFPROBE=ffprobe

# Duration tolerance (seconds) when verifying a converted file matches source.
DOWNSIZARR_DURATION_TOLERANCE=1.0

# Video file extensions that are considered convertible (comma separated).
DOWNSIZARR_VIDEO_EXTENSIONS=.mkv,.mp4,.avi,.mov,.m4v,.ts,.wmv,.flv,.mpg,.mpeg,.m2ts

# HTTP port inside the container.
DOWNSIZARR_PORT=8080
